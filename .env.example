# 「余白の音」環境変数ひな形
# このファイルはテンプレートです。実際の値は .env.local にコピーして設定してください(.env.local はgit管理外)。
# 現時点(雛形フェーズ)ではSupabase/Vercelへの実接続は行っていないため、値は未設定のままで構いません。

# --- Supabase(未接続・将来使用) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- アプリ基本設定 ---
NEXT_PUBLIC_APP_NAME="余白の音"
NEXT_PUBLIC_APP_URL=http://localhost:3000
